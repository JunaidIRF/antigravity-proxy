# ========================================================
# Antigravity Proxy Configuration (.env)
# ========================================================

# Host IP to bind the server to:
# - "127.0.0.1" (default: localhost only - recommended for security)
# - "0.0.0.0"   (accessible from other devices on your local network / LAN)
HOST=127.0.0.1

# Port to listen on (default: 8877)
PORT=8877

# Backend upstream Google API endpoint (default: daily-cloudcode-pa.googleapis.com)
ANTIGRAVITY_ENDPOINT=https://daily-cloudcode-pa.googleapis.com

# Custom token file location (leave empty to use default ~/.gemini/antigravity-cli/antigravity-oauth-token)
# ANTIGRAVITY_TOKEN_PATH=C:\path\to\token.json
